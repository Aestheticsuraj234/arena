# Production settings for docker-compose.prod.yml.
# ./scripts/setup-production.sh writes this file for you with random secrets.

# Where the app is served. A plain hostname gets HTTPS from Let's Encrypt;
# use http://… for an IP or a private network.
WEB_ADDRESS=arena.example.com
API_ADDRESS=api.arena.example.com
WEB_URL=https://arena.example.com
API_URL=https://api.arena.example.com
# Parent domain of both, so the session cookie is shared.
COOKIE_DOMAIN=arena.example.com
ACME_EMAIL=you@example.com

# Secrets (openssl rand -base64 32)
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
GRAFANA_ADMIN_PASSWORD=
# Optional: require a bearer token on the API's /metrics.
METRICS_TOKEN=

# Capacity
WORKER_CONCURRENCY=2
RATE_LIMIT_PER_MINUTE=120
SEED_PROBLEMS=true

# Optional: pull base images from a mirror if Docker Hub rate-limits you.
# BASE_REGISTRY=public.ecr.aws/docker/library
