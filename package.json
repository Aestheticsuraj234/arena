{
  "name": "arena",
  "private": true,
  "description": "Self-hosted remote code execution engine with a Judge0-compatible API",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @arena/db db:migrate",
    "setup": "docker compose up -d && pnpm db:migrate && pnpm db:seed",
    "db:seed": "pnpm --filter @arena/db db:seed",
    "db:generate": "pnpm --filter @arena/db db:generate",
    "images:build": "./scripts/build-images.sh",
    "test:images": "pnpm --filter @arena/engine test:images",
    "smoke": "./scripts/smoke-api.sh",
    "test:docker": "pnpm --filter @arena/engine test:docker",
    "e2e": "pnpm --filter @arena/e2e e2e",
    "load-test": "node tests/load/judge-load.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.0.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  }
}
